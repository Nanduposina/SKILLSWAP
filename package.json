{
  "name": "skillswap-learning-network",
  "version": "1.0.0",
  "description": "Peer-to-peer skill exchange platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "client": "cd src/frontend && npm start",
    "build": "cd src/frontend && npm run build",
    "install-client": "cd src/frontend && npm install",
    "heroku-postbuild": "npm run install-client && npm run build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/smoke/application.test.js",
    "verify": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "prisma": "^6.19.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "skill-sharing",
    "learning",
    "peer-to-peer",
    "education",
    "exchange"
  ],
  "author": "SkillSwap Team",
  "license": "MIT"
}
